---
import Breadcrumb, { type BreadcrumbItem } from "@/components/Breadcrumb.astro";
import type { Locale } from "@/i18n/config";
import { SITE } from "@/config";

type Props = {
  pageTitle: string;
  titleTransition?: string;
  locale?: Locale;
  pageDesc?: string;
  descriptionStyle?: "normal" | "italic";
  breadcrumbs?: BreadcrumbItem[];
  searchableHeader?: "title" | "title-description";
};

const { props } = Astro;
const locale = props.locale;
const backUrl = SITE.showBackButton ? Astro.url.pathname : "/";
---

<Breadcrumb {locale} items={props.breadcrumbs} />
<main data-backUrl={backUrl} id="main-content" class="app-layout pb-4">
  <h1
    class="text-2xl font-semibold sm:text-3xl"
    data-pagefind-body={props.searchableHeader ? true : undefined}
  >
    {
      props.titleTransition ? (
        <span transition:name={props.titleTransition}>{props.pageTitle}</span>
      ) : (
        props.pageTitle
      )
    }
  </h1>
  <p
    class:list={["mt-2 mb-6", { italic: props.descriptionStyle !== "normal" }]}
    data-pagefind-body={props.searchableHeader === "title-description"
      ? true
      : undefined}
  >
    {props.pageDesc}
  </p>
  <slot />
</main>

<script>
  document.addEventListener("astro:page-load", () => {
    const mainContent: HTMLElement | null =
      document.querySelector("#main-content");
    const backUrl = mainContent?.dataset?.backurl;
    if (backUrl) {
      sessionStorage.setItem("backUrl", backUrl);
    }
  });
</script>
