---
import IconLanguage from "@/assets/icons/IconLanguage.svg";
import {
  LOCALE_LABELS,
  SUPPORTED_LOCALES,
  type Locale,
} from "@/i18n/config";
import { switchLocaleInPath } from "@/i18n/routes";
import { t } from "@/i18n/ui";

type Props = {
  links?: Partial<Record<Locale, string>>;
  locale: Locale;
};

const { links = {}, locale } = Astro.props;

const languageOptions = SUPPORTED_LOCALES.map(targetLocale => ({
  href: links[targetLocale] ?? switchLocaleInPath(Astro.url.pathname, targetLocale),
  isActive: targetLocale === locale,
  label: LOCALE_LABELS[targetLocale],
  locale: targetLocale,
}));
---

<details class="group relative">
  <summary
    class="focus-outline flex size-12 list-none items-center justify-center p-4 hover:[&>svg]:stroke-accent sm:size-8 sm:p-1"
    aria-label={t(locale, "nav.language")}
    title={t(locale, "nav.language")}
  >
    <IconLanguage />
    <span class="sr-only">{t(locale, "nav.language")}</span>
  </summary>
  <ul
    class="absolute end-0 top-full z-20 mt-2 min-w-32 rounded-md border border-border bg-background py-1 shadow-lg"
  >
    {
      languageOptions.map(option => (
        <li>
          <a
            href={option.href}
            hreflang={option.locale}
            aria-current={option.isActive ? "true" : undefined}
            class:list={[
              "block px-3 py-2 text-sm whitespace-nowrap hover:text-accent",
              { "text-accent": option.isActive },
            ]}
          >
            {option.label}
          </a>
        </li>
      ))
    }
  </ul>
</details>

<style>
  summary::-webkit-details-marker {
    display: none;
  }
</style>
