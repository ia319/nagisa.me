---
import type { Locale } from "@/i18n/config";
import {
  getLocaleFromPathname,
  getLocalizedPath,
  stripLocaleFromPathname,
} from "@/i18n/routes";
import { t } from "@/i18n/ui";

export type BreadcrumbItem = { label: string; href?: string };

type Props = {
  locale?: Locale;
  items?: BreadcrumbItem[];
};

const locale = Astro.props.locale ?? getLocaleFromPathname(Astro.url.pathname);
const explicitItems = Astro.props.items;
const currentUrlPath = stripLocaleFromPathname(Astro.url.pathname).replace(
  /\/+$/,
  ""
);
const breadcrumbList = currentUrlPath.split("/").slice(1);

if (breadcrumbList[0] === "posts") {
  breadcrumbList.splice(
    0,
    2,
    t(locale, "breadcrumb.postsPage").replace(
      "{page}",
      breadcrumbList[1] || "1"
    )
  );
}

const items =
  explicitItems ??
  breadcrumbList.map((label, index) => ({
    label: decodeURIComponent(label),
    href:
      index === breadcrumbList.length - 1
        ? undefined
        : getLocalizedPath(locale, `/${label}/`),
  }));
---

<nav class="app-layout mt-8 mb-1" aria-label={t(locale, "breadcrumb.label")}>
  <ul
    class="font-light [&>li]:inline [&>li:not(:last-child)>a]:hover:opacity-100"
  >
    <li>
      <a href={getLocalizedPath(locale)} class="opacity-80"
        >{t(locale, "breadcrumb.home")}</a
      >
      <span aria-hidden="true" class="opacity-80">&raquo;</span>
    </li>
    {
      items.map(({ label, href }, index) => (
        <li>
          {href ? (
            <>
              <a
                href={href}
                class:list={["opacity-70", { capitalize: !explicitItems }]}
              >
                {label}
              </a>
              <span aria-hidden="true">&raquo;</span>
            </>
          ) : (
            <span
              class:list={[
                "opacity-75",
                {
                  capitalize: !explicitItems,
                  lowercase: !explicitItems && index > 0,
                },
              ]}
              aria-current="page"
            >
              {label}
            </span>
          )}
        </li>
      ))
    }
  </ul>
</nav>
