---
import type { HTMLAttributes } from "astro/types";
import { SITE } from "@/config";
import type { Locale } from "@/i18n/config";
import { getLocaleFromPathname } from "@/i18n/routes";
import { t } from "@/i18n/ui";
import Socials from "./Socials.astro";

const currentYear = new Date().getFullYear();

type Props = {
  locale?: Locale;
  noMarginTop?: boolean;
} & HTMLAttributes<"footer">;

const {
  locale: propLocale,
  noMarginTop = false,
  class: className,
  ...attrs
} = Astro.props;
const locale = propLocale ?? getLocaleFromPathname(Astro.url.pathname);
---

<footer
  class:list={["app-layout", { "mt-auto": !noMarginTop }, className]}
  {...attrs}
>
  <div
    class:list={[
      "py-6 sm:py-4",
      "border-t border-border",
      "flex flex-col items-center justify-between sm:flex-row-reverse",
    ]}
  >
    <Socials />
    <div
      class="my-2 flex flex-col items-center gap-1.5 text-sm leading-5 font-normal text-foreground sm:items-start"
    >
      <p lang="en">As the heart wills</p>
      <div
        class="flex flex-wrap items-center justify-center gap-x-2 gap-y-1 sm:justify-start"
      >
        <span class="whitespace-nowrap">{currentYear} {SITE.author}</span>
        <span aria-hidden="true">·</span>
        <a
          href="https://creativecommons.org/publicdomain/zero/1.0/"
          class="whitespace-nowrap underline decoration-dashed underline-offset-4 hover:decoration-solid"
        >
          {t(locale, "footer.contentLicense")} CC0
        </a>
        <span aria-hidden="true">·</span>
        <a
          href={`${SITE.repository}/blob/main/LICENSE`}
          class="whitespace-nowrap underline decoration-dashed underline-offset-4 hover:decoration-solid"
        >
          {t(locale, "footer.codeLicense")} MIT
        </a>
      </div>
    </div>
  </div>
</footer>
