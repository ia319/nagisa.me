---
import type { CollectionEntry } from "astro:content";
import type { Locale } from "@/i18n/config";
import { slugifyStr } from "@/utils/slugify";
import { getPath } from "@/utils/getPath";
import { getPostLocale } from "@/utils/postI18n";
import Datetime from "./Datetime.astro";

type Props = {
  locale?: Locale;
  variant?: "h2" | "h3";
} & CollectionEntry<"blog">;

const {
  locale: propLocale,
  variant: Heading = "h2",
  id,
  data,
  filePath,
} = Astro.props;
const locale = propLocale ?? getPostLocale(id);

const { title, description, ...props } = data;
---

<li class="my-6">
  <a
    href={getPath(id, filePath, { locale })}
    class:list={[
      "inline-block text-lg font-medium text-accent",
      "decoration-dashed underline-offset-4 hover:underline",
      "focus-visible:no-underline focus-visible:underline-offset-0",
    ]}
  >
    <Heading
      style={{ viewTransitionName: slugifyStr(title.replaceAll(".", "-")) }}
    >
      {title}
    </Heading>
  </a>
  <Datetime {...props} />
  <p>{description}</p>
</li>
