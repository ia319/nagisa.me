---
import { getCollection, render } from "astro:content";
import type { Locale } from "@/i18n/config";
import { findLocalizedPageContent } from "@/utils/pageContent";

type HeadingLevel = "h1" | "h2" | "h3" | "h4" | "h5" | "h6";

type Props = {
  class?: string;
  contentId: string;
  headingClass?: string;
  headingLevel?: HeadingLevel;
  id?: string;
  locale: Locale;
};

const {
  class: className = "",
  contentId,
  headingClass = "not-prose text-xl font-semibold tracking-wide",
  headingLevel: Heading = "h2",
  id,
  locale,
} = Astro.props;

const pageContents = await getCollection("pages");
const pageContent = findLocalizedPageContent(pageContents, contentId, locale);
const Content = pageContent ? (await render(pageContent)).Content : undefined;
---

{
  pageContent && Content && (
    <div id={id} class:list={["app-prose max-w-app", className]}>
      <Heading class={headingClass}>{pageContent.data.title}</Heading>
      <Content />
    </div>
  )
}
