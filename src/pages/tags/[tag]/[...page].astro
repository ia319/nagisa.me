---
import { getCollection } from "astro:content";
import type { GetStaticPathsOptions } from "astro";
import { getTagIndex } from "@/utils/getTagIndex";
import getPostsByTag from "@/utils/getPostsByTag";
import { DEFAULT_LOCALE } from "@/i18n/config";
import { getLocalizedPath } from "@/i18n/routes";
import { SITE } from "@/config";

export async function getStaticPaths({ paginate }: GetStaticPathsOptions) {
  const index = getTagIndex(
    await getCollection("blog"),
    await getCollection("tags")
  );
  return index.tags
    .filter(item => item.locale === DEFAULT_LOCALE)
    .flatMap(({ tag }) => {
      const segments = [
        tag,
        ...index.aliases
          .filter(alias => alias.locale === DEFAULT_LOCALE && alias.tag === tag)
          .map(alias => alias.alias),
      ];
      return segments.flatMap(segment =>
        paginate(getPostsByTag(index.posts, tag, DEFAULT_LOCALE), {
          params: { tag: segment },
          props: {
            redirectPath: getLocalizedPath(
              DEFAULT_LOCALE,
              `/tags/${encodeURIComponent(tag)}`
            ),
          },
          pageSize: SITE.postPerPage,
        })
      );
    });
}

const { page, redirectPath } = Astro.props;
return Astro.redirect(
  `${redirectPath}${page.currentPage > 1 ? "/" + page.currentPage : ""}`,
  301
);
---
