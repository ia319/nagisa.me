---
import { getCollection } from "astro:content";
import Main from "@/layouts/Main.astro";
import Layout from "@/layouts/Layout.astro";
import Tag from "@/components/Tag.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import { getTagIndex, type TagRoute } from "@/utils/getTagIndex";
import { SUPPORTED_LOCALES, type Locale } from "@/i18n/config";
import { t } from "@/i18n/ui";
import { SITE } from "@/config";

type Props = {
  locale: Locale;
  tags: TagRoute[];
};

/**
 * Generate each language's collection from the public tag index.
 * @returns Localized collection routes and their tag data.
 * @throws {Error} When content identities or public tag routes conflict.
 */
export async function getStaticPaths() {
  const index = getTagIndex(await getCollection("blog"));
  return SUPPORTED_LOCALES.map(locale => ({
    params: { locale },
    props: { locale, tags: index.tags.filter(tag => tag.locale === locale) },
  }));
}

const { locale, tags } = Astro.props;
---

<Layout locale={locale} title={`${t(locale, "tags.title")} | ${SITE.title}`}>
  <Header locale={locale} />
  <Main
    locale={locale}
    pageTitle={t(locale, "tags.title")}
    pageDesc={t(locale, "tags.description")}
  >
    <ul class="flex flex-wrap gap-6">
      {tags.map(({ tag, tagName }) => <Tag {tag} {tagName} locale={locale} />)}
    </ul>
  </Main>
  <Footer locale={locale} />
</Layout>
