---
import { getCollection } from "astro:content";
import Main from "@/layouts/Main.astro";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import { getTagIndex, type TagRoute } from "@/utils/getTagIndex";
import { SUPPORTED_LOCALES, type Locale } from "@/i18n/config";
import { getLocalizedPath } from "@/i18n/routes";
import { t } from "@/i18n/ui";
import { SITE } from "@/config";

type Props = {
  locale: Locale;
  tags: TagRoute[];
};

/**
 * Generate each language's collection from the public tag index.
 * @returns Localized collection routes and their tag data.
 * @throws {Error} When content identities or public tag routes conflict.
 */
export async function getStaticPaths() {
  const index = getTagIndex(
    await getCollection("blog"),
    await getCollection("tags")
  );
  return SUPPORTED_LOCALES.map(locale => ({
    params: { locale },
    props: { locale, tags: index.tags.filter(tag => tag.locale === locale) },
  }));
}

const { locale, tags } = Astro.props;
---

<Layout locale={locale} title={`${t(locale, "tags.title")} | ${SITE.title}`}>
  <Header locale={locale} />
  <Main
    locale={locale}
    pageTitle={t(locale, "tags.title")}
    pageDesc={t(locale, "tags.description")}
    breadcrumbs={[{ label: t(locale, "tags.title") }]}
  >
    <ul class="divide-y divide-border">
      {
        tags.map(({ tag, tagName, count, description }) => (
          <li class="py-6 first:pt-0">
            <div class="flex flex-wrap items-baseline gap-x-3 gap-y-1">
              <h2 class="text-lg font-medium">
                <a
                  href={getLocalizedPath(
                    locale,
                    `/tags/${encodeURIComponent(tag)}/`
                  )}
                  class="text-accent underline decoration-dashed underline-offset-4 hover:decoration-solid"
                >
                  {tagName}
                </a>
              </h2>
              <span class="text-sm text-foreground/70">
                {t(
                  locale,
                  new Intl.PluralRules(locale).select(count) === "one"
                    ? "tag.articleCount.one"
                    : "tag.articleCount.other"
                ).replace(
                  "{count}",
                  new Intl.NumberFormat(locale).format(count)
                )}
              </span>
            </div>
            <p class="mt-2 text-foreground/80">
              {description?.trim() ||
                `${t(locale, "tag.descriptionPrefix")}${tagName}${t(locale, "tag.descriptionSuffix")}`}
            </p>
          </li>
        ))
      }
    </ul>
  </Main>
  <Footer locale={locale} />
</Layout>
