---
import { getCollection, render, type CollectionEntry } from "astro:content";
import type { GetStaticPathsOptions, Page } from "astro";
import Main from "@/layouts/Main.astro";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import Card from "@/components/Card.astro";
import ContentGitMeta from "@/components/ContentGitMeta.astro";
import Pagination from "@/components/Pagination.astro";
import { getTagIndex, getTagLanguageLinks } from "@/utils/getTagIndex";
import getPostsByTag from "@/utils/getPostsByTag";
import type { Locale } from "@/i18n/config";
import { getLocalizedPath } from "@/i18n/routes";
import { t } from "@/i18n/ui";
import { SITE } from "@/config";

type Props = {
  locale: Locale;
  page: Page<CollectionEntry<"blog">>;
  tagName: string;
  description?: string;
  entry?: CollectionEntry<"tags">;
  redirectTag?: string;
  languageLinks: Partial<Record<Locale, string>>;
};

/**
 * Paginate public tag routes with verified cross-language destinations.
 * @param options Astro's pagination helper.
 * @returns Tag detail pages with localized articles and language links.
 * @throws {Error} When content identities or public tag routes conflict.
 */
export async function getStaticPaths({ paginate }: GetStaticPathsOptions) {
  const index = getTagIndex(
    await getCollection("blog"),
    await getCollection("tags")
  );
  for (const diagnostic of index.diagnostics) {
    process.stderr.write(`[tags] ${diagnostic.message}\n`);
  }

  return index.tags.flatMap(tagRoute => {
    const { locale, tag, tagName, description, entry } = tagRoute;
    const tagPosts = getPostsByTag(index.posts, tag, locale);
    const languageLinks = getTagLanguageLinks(index, tagRoute);
    const routes = [
      { segment: tag },
      ...index.aliases
        .filter(alias => alias.locale === locale && alias.tag === tag)
        .map(alias => ({ segment: alias.alias, redirectTag: tag })),
    ];
    return routes.flatMap(route =>
      paginate(tagPosts, {
        params: { locale, tag: route.segment },
        props: {
          locale,
          tagName,
          description,
          entry,
          languageLinks,
          redirectTag: "redirectTag" in route ? route.redirectTag : undefined,
        },
        pageSize: SITE.postPerPage,
      })
    );
  });
}

const tag = Astro.params.tag ?? "";
const {
  page,
  locale,
  tagName,
  description,
  entry,
  languageLinks,
  redirectTag,
} = Astro.props;
if (redirectTag)
  return Astro.redirect(
    getLocalizedPath(
      locale,
      `/tags/${encodeURIComponent(redirectTag)}/${page.currentPage > 1 ? page.currentPage + "/" : ""}`
    ),
    301
  );
const canonicalPath = getLocalizedPath(
  locale,
  `/tags/${encodeURIComponent(tag)}/`
);
const breadcrumbs = [
  { label: t(locale, "tags.title"), href: getLocalizedPath(locale, "/tags/") },
  { label: tagName, ...(page.currentPage > 1 ? { href: canonicalPath } : {}) },
  ...(page.currentPage > 1
    ? [
        {
          label: t(locale, "breadcrumb.page").replace(
            "{page}",
            String(page.currentPage)
          ),
        },
      ]
    : []),
];
const hasBody = Boolean(entry?.body?.trim());
const hasIntroduction =
  page.currentPage === 1 && Boolean(entry && (description?.trim() || hasBody));
const searchableHeader = hasIntroduction
  ? description?.trim()
    ? "title-description"
    : "title"
  : undefined;
const rendered =
  page.currentPage === 1 && hasBody && entry ? await render(entry) : undefined;
const Content = rendered?.Content;
const summary =
  description?.trim() ||
  `${t(locale, "tag.descriptionPrefix")}${tagName}${t(locale, "tag.descriptionSuffix")}`;
---

<Layout
  locale={locale}
  title={`${t(locale, "tag.titlePrefix")} ${tagName} | ${SITE.title}`}
>
  <Header locale={locale} languageLinks={languageLinks} />
  <Main
    locale={locale}
    pageTitle={tagName}
    titleTransition={tag}
    pageDesc={summary}
    descriptionStyle="normal"
    {searchableHeader}
    {breadcrumbs}
  >
    {
      page.currentPage === 1 ? (
        Content && (
          <>
            <a
              href="#related-articles"
              class="mb-6 inline-block text-accent underline decoration-dashed underline-offset-4 hover:decoration-solid"
            >
              {t(locale, "tag.viewArticles")}
            </a>
            <div
              class="tag-content app-prose w-full max-w-app wrap-break-word"
              data-pagefind-body
            >
              <Content />
            </div>
          </>
        )
      ) : (
        <a
          href={canonicalPath + "#main-content"}
          class="inline-block text-accent underline decoration-dashed underline-offset-4 hover:decoration-solid"
        >
          {t(locale, "tag.backToIntroduction")}
        </a>
      )
    }
    {
      hasIntroduction && entry && (
        <ContentGitMeta filePath={entry.filePath} locale={locale} />
      )
    }
    <hr class="my-8 border-border" />
    <section
      id="related-articles"
      aria-labelledby="related-articles-title"
      tabindex="-1"
      class="scroll-mt-8"
    >
      <h2
        id="related-articles-title"
        class="flex flex-wrap items-baseline gap-x-3 gap-y-1 text-xl font-semibold"
      >
        {t(locale, "tag.relatedArticles")}
        <span class="text-sm font-normal text-foreground/70"
          >{
            t(
              locale,
              page.total === 1
                ? "tag.articleCount.one"
                : "tag.articleCount.other"
            ).replace(
              "{count}",
              new Intl.NumberFormat(locale).format(page.total)
            )
          }</span
        >
      </h2>
      <ul>
        {page.data.map(data => <Card locale={locale} variant="h3" {...data} />)}
      </ul>
    </section>
  </Main>

  <Pagination page={page} locale={locale} />

  <Footer locale={locale} noMarginTop={page.lastPage > 1} />
</Layout>

<style>
  .tag-content :global(table) {
    display: block;
    max-width: 100%;
    overflow-x: auto;
  }
</style>
