---
import { getCollection, type CollectionEntry } from "astro:content";
import type { GetStaticPathsOptions, Page } from "astro";
import Main from "@/layouts/Main.astro";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import Card from "@/components/Card.astro";
import Pagination from "@/components/Pagination.astro";
import { getTagIndex, getTagLanguageLinks } from "@/utils/getTagIndex";
import getPostsByTag from "@/utils/getPostsByTag";
import type { Locale } from "@/i18n/config";
import { getLocalizedPath } from "@/i18n/routes";
import { t } from "@/i18n/ui";
import { SITE } from "@/config";

type Props = {
  locale: Locale;
  page: Page<CollectionEntry<"blog">>;
  tagName: string;
  redirectTag?: string;
  languageLinks: Partial<Record<Locale, string>>;
};

/**
 * Paginate public tag routes with verified cross-language destinations.
 * @param options Astro's pagination helper.
 * @returns Tag detail pages with localized articles and language links.
 * @throws {Error} When content identities or public tag routes conflict.
 */
export async function getStaticPaths({ paginate }: GetStaticPathsOptions) {
  const index = getTagIndex(
    await getCollection("blog"),
    await getCollection("tags")
  );
  for (const diagnostic of index.diagnostics) {
    process.stderr.write(`[tags] ${diagnostic.message}\n`);
  }

  return index.tags.flatMap(tagRoute => {
    const { locale, tag, tagName } = tagRoute;
    const tagPosts = getPostsByTag(index.posts, tag, locale);
    const languageLinks = getTagLanguageLinks(index, tagRoute);
    const routes = [
      { segment: tag },
      ...index.aliases
        .filter(alias => alias.locale === locale && alias.tag === tag)
        .map(alias => ({ segment: alias.alias, redirectTag: tag })),
    ];
    return routes.flatMap(route =>
      paginate(tagPosts, {
        params: { locale, tag: route.segment },
        props: {
          locale,
          tagName,
          languageLinks,
          redirectTag: "redirectTag" in route ? route.redirectTag : undefined,
        },
        pageSize: SITE.postPerPage,
      })
    );
  });
}

const tag = Astro.params.tag ?? "";
const { page, locale, tagName, languageLinks, redirectTag } = Astro.props;
if (redirectTag)
  return Astro.redirect(
    getLocalizedPath(
      locale,
      `/tags/${encodeURIComponent(redirectTag)}/${page.currentPage > 1 ? page.currentPage + "/" : ""}`
    ),
    301
  );
---

<Layout
  locale={locale}
  title={`${t(locale, "tag.titlePrefix")} ${tagName} | ${SITE.title}`}
>
  <Header locale={locale} languageLinks={languageLinks} />
  <Main
    locale={locale}
    pageTitle={[t(locale, "tag.titlePrefix"), `${tagName}`]}
    titleTransition={tag}
    pageDesc={`${t(locale, "tag.descriptionPrefix")}${tagName}${t(locale, "tag.descriptionSuffix")}`}
  >
    <h1 slot="title" transition:name={tag}>
      {`${t(locale, "tag.titlePrefix")}${tagName}`}
    </h1>
    <ul>
      {page.data.map(data => <Card locale={locale} {...data} />)}
    </ul>
  </Main>

  <Pagination page={page} locale={locale} />

  <Footer locale={locale} noMarginTop={page.lastPage > 1} />
</Layout>
