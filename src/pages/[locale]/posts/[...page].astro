---
import type { GetStaticPaths, Page } from "astro";
import { getCollection, type CollectionEntry } from "astro:content";
import Main from "@/layouts/Main.astro";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import Card from "@/components/Card.astro";
import Pagination from "@/components/Pagination.astro";
import getSortedPosts from "@/utils/getSortedPosts";
import { SUPPORTED_LOCALES, type Locale } from "@/i18n/config";
import { t } from "@/i18n/ui";
import { SITE } from "@/config";

type Props = {
  locale: Locale;
  page: Page<CollectionEntry<"blog">>;
};

export const getStaticPaths = (async ({ paginate }) => {
  const posts = await getCollection("blog", ({ data }) => !data.draft);

  return SUPPORTED_LOCALES.flatMap(locale =>
    paginate(getSortedPosts(posts, locale), {
      params: { locale },
      pageSize: SITE.postPerPage,
      props: { locale },
    })
  );
}) satisfies GetStaticPaths;

const { page, locale } = Astro.props;
---

<Layout locale={locale} title={`${t(locale, "posts.title")} | ${SITE.title}`}>
  <Header locale={locale} />
  <Main
    locale={locale}
    pageTitle={t(locale, "posts.title")}
    pageDesc={t(locale, "posts.description")}
  >
    <ul>
      {page.data.map(data => <Card locale={locale} {...data} />)}
    </ul>
  </Main>

  <Pagination page={page} locale={locale} />

  <Footer locale={locale} noMarginTop={page.lastPage > 1} />
</Layout>
