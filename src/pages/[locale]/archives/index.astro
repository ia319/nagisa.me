---
import { getCollection } from "astro:content";
import Main from "@/layouts/Main.astro";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import Card from "@/components/Card.astro";
import getPostsByGroupCondition from "@/utils/getPostsByGroupCondition";
import getSortedPosts from "@/utils/getSortedPosts";
import { SUPPORTED_LOCALES, type Locale } from "@/i18n/config";
import { formatMonthName } from "@/i18n/format";
import { t } from "@/i18n/ui";
import { SITE } from "@/config";

type Props = {
  locale: Locale;
};

export function getStaticPaths() {
  return SUPPORTED_LOCALES.map(locale => ({
    params: { locale },
    props: { locale },
  }));
}

const { locale } = Astro.props;

// Redirect to 404 page if `showArchives` config is false
if (!SITE.showArchives) {
  return Astro.redirect("/404");
}

const rawPosts = await getCollection("blog", ({ data }) => !data.draft);
const posts = getSortedPosts(rawPosts, locale);
---

<Layout
  locale={locale}
  title={`${t(locale, "archives.title")} | ${SITE.title}`}
>
  <Header locale={locale} />
  <Main
    locale={locale}
    pageTitle={t(locale, "archives.title")}
    pageDesc={t(locale, "archives.description")}
  >
    {
      Object.entries(
        getPostsByGroupCondition(posts, post =>
          post.data.pubDatetime.getFullYear()
        )
      )
        .sort(([yearA], [yearB]) => Number(yearB) - Number(yearA))
        .map(([year, yearGroup]) => (
          <div>
            <span class="text-2xl font-bold">{year}</span>
            <sup class="text-sm">{yearGroup.length}</sup>
            {Object.entries(
              getPostsByGroupCondition(
                yearGroup,
                post => post.data.pubDatetime.getMonth() + 1
              )
            )
              .sort(([monthA], [monthB]) => Number(monthB) - Number(monthA))
              .map(([month, monthGroup]) => (
                <div class="flex flex-col sm:flex-row">
                  <div class="mt-6 min-w-36 text-lg sm:my-6">
                    <span class="font-bold">
                      {formatMonthName(Number(month), locale)}
                    </span>
                    <sup class="text-xs">{monthGroup.length}</sup>
                  </div>
                  <ul>
                    {monthGroup.map(data => (
                      <Card locale={locale} {...data} />
                    ))}
                  </ul>
                </div>
              ))}
          </div>
        ))
    }
  </Main>
  <Footer locale={locale} />
</Layout>
